<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AndroCp.App.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="16" /></Style>
  </Application.Styles>
</Application>
